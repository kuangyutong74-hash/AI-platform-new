# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and builds
/coverage
**/coverage/
/.next/
/.vinext/
/out/
/dist/
**/dist/
# 验收/回滚用的构建输出（dist-verify、dist.old.<时间戳>）
**/dist-verify/
**/dist.old.*/

# caches and runtimes
**/__pycache__/
**/.pytest_cache/
**/.venv/
*.py[cod]
/modules/platform-core/data/*.db
/modules/platform-core/data/*.db-wal
/modules/platform-core/data/*.db-shm
/modules/platform-core/data/backups/
/.wrangler/
/.runtime/
**/.runtime/
/outputs/
/work/

# local and debug files
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
!**/.env.example
.vercel
/.claude/
/.workbuddy/
/.codex-start.*.log
