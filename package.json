{
  "name": "ai-bole-integrated-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 4173",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --port 4173",
    "test": "npm run build && npm run test:node && npm run test:scripts && npm run test:backend",
    "test:node": "node --test tests/rendered-html.test.mjs tests/explorer-data.test.mjs tests/view-state.test.mjs tests/contracts.test.mjs tests/module-launch-context.test.mjs",
    "test:scripts": "pwsh -NoProfile -File tests/startup-registry.test.ps1",
    "test:backend": "pwsh -NoProfile -File tests/run-backend-tests.ps1",
    "build:modules": "npm --prefix modules/deep-sea run build && npm --prefix modules/story/frontend run build && npm --prefix modules/talent-report run build",
    "test:modules": "cross-env DEEPSEEK_API_KEY=test-only-key npm --prefix modules/chat test",
    "verify:workspace": "npm test && npm run build:modules && npm run test:modules",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
